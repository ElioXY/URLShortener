{
  
  "name": "urlshortener",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "0c33a310-95de-492c-b250-154f910ea9d6"
    }
  ],
  "observability": {
    "enabled": true
  }
}
